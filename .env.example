NODE_ENV=development
PORT=3000
DEMO_MODE=false
UPLOAD_DIR=uploads
EMAIL_OUTBOX_DIR=tmp/outbox
# Railway demo: DEMO_MODE=true requires EMAIL_REDIRECT_TO. Mount /data and use
# UPLOAD_DIR=/data/uploads and EMAIL_OUTBOX_DIR=/data/outbox. See DEPLOY-RAILWAY.md.

# The api runs on the Windows host (pnpm run dev / dev:api), not in Docker.
# Postgres runs in WSL2 Docker and is reached from Windows via WSL2's
# localhost forwarding — see README for details. If the DATABASE_HOST is
# "postgres" you're inside a container on the compose network instead
# (only docker-compose.yml's own `api` service, kept for a future
# production-style deploy, would need that).
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=sanad
DATABASE_PASSWORD=sanad
DATABASE_NAME=sanad
DATABASE_SSL=false

PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@sanad.com
PGADMIN_PASSWORD=admin

# Only needed on Windows, and only if you have more than one WSL
# distribution — name of the one running Docker. Leave unset to use
# your WSL default.
WSL_DISTRO=

# "fake" needs no credentials and makes no network calls — the safe default
# for a fresh checkout. Set to "mistral" + a real AI_API_KEY to use the real
# provider.
LLM_PROVIDER=fake
AI_API_KEY=
AI_MODEL=mistral-small-latest
# Model for turning a finished section's chat into a structured card — a
# stronger model than AI_MODEL, since the small one often drops real entries.
AI_EXTRACTION_MODEL=mistral-medium-latest

# Speech-to-text for voice messages (POST /transcriptions). Uses the same
# AI_API_KEY. "fake" returns a fixed Arabic line with no network calls.
STT_PROVIDER=fake
STT_MODEL=voxtral-mini-latest

# Embeddings for job matching (stored in pgvector). Uses the same AI_API_KEY. "fake" is a local
# hashed bag-of-words — no network calls. The DB column is vector(1024), mistral-embed's size.
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=mistral-embed

# Application emails. "fake" writes each email + its PDF to ./tmp/outbox instead of sending.
# "resend" needs RESEND_API_KEY and a FROM address on a domain verified in Resend (SPF + DKIM).
EMAIL_PROVIDER=fake
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Sanad
# Dev safety net: when set, every application email goes HERE instead of to the company.
EMAIL_REDIRECT_TO=

# Job search (Jooble). "fake" makes no network calls — Jooble's free plan is a total LIFETIME limit
# of 500 requests per key (not renewing), so this must stay "fake" until you're deliberately ready
# to spend real calls. JOOBLE_MAX_CALLS is a safety margin under that real 500 cap, per key.
# Keys are per country site: a jooble.org key returns US jobs only (0 for Egypt, no error). Register
# each market's key on its own site: eg.jooble.org/api/about, sa.jooble.org/api/about, ae.jooble.org/api/about, de.jooble.org/api/about.
JOB_PROVIDER=fake
JOOBLE_API_KEY_EG=
JOOBLE_API_KEY_SA=
JOOBLE_API_KEY_AE=
JOOBLE_API_KEY_DE=
JOOBLE_MAX_CALLS=450
JOB_CACHE_TTL_DAYS=30
