@baseUrl = http://localhost:3000/api/v1
@deviceId = 3e6b6c8e-8b8b-4b8b-9b8b-8b8b8b8b8b8b

### Health check (no X-Device-Id needed — @Public())
GET {{baseUrl}}/health

### Register a new device
POST {{baseUrl}}/devices
Content-Type: application/json
X-Device-Id: {{deviceId}}

{
  "platform": "android",
  "appVersion": "1.0.0",
  "locale": "ar-EG",
  "region": "EG"
}

### Register the same device again — must be idempotent, same deviceId/createdAt back
POST {{baseUrl}}/devices
Content-Type: application/json
X-Device-Id: {{deviceId}}

{
  "platform": "android",
  "appVersion": "1.0.1",
  "locale": "ar-EG",
  "region": "EG"
}

### Missing X-Device-Id — DEVICE_REQUIRED
POST {{baseUrl}}/devices
Content-Type: application/json

{
  "platform": "android",
  "appVersion": "1.0.0",
  "locale": "ar-EG",
  "region": "EG"
}

### Malformed X-Device-Id (not a uuid v4) — INVALID_REQUEST
POST {{baseUrl}}/devices
Content-Type: application/json
X-Device-Id: not-a-uuid

{
  "platform": "android",
  "appVersion": "1.0.0",
  "locale": "ar-EG",
  "region": "EG"
}
