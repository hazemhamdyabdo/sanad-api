@baseUrl = http://localhost:3000/api/v1
@deviceId = 3e6b6c8e-8b8b-4b8b-9b8b-8b8b8b8b8b8b

### Health check (no X-Device-Id needed — @Public())
GET {{baseUrl}}/health

### Register a new device
POST {{baseUrl}}/devices
Content-Type: application/json
X-Device-Id: {{deviceId}}

{
  "platform": "android",
  "appVersion": "1.0.0",
  "locale": "ar-EG",
  "region": "EG"
}

### Register the same device again — must be idempotent, same deviceId/createdAt back
POST {{baseUrl}}/devices
Content-Type: application/json
X-Device-Id: {{deviceId}}

{
  "platform": "android",
  "appVersion": "1.0.1",
  "locale": "ar-EG",
  "region": "EG"
}

### Missing X-Device-Id — DEVICE_REQUIRED
POST {{baseUrl}}/devices
Content-Type: application/json

{
  "platform": "android",
  "appVersion": "1.0.0",
  "locale": "ar-EG",
  "region": "EG"
}

### Malformed X-Device-Id (not a uuid v4) — INVALID_REQUEST
POST {{baseUrl}}/devices
Content-Type: application/json
X-Device-Id: not-a-uuid

{
  "platform": "android",
  "appVersion": "1.0.0",
  "locale": "ar-EG",
  "region": "EG"
}

### A device that's never been registered — NOT_FOUND (from DeviceGuard's DB lookup, not DEVICE_REQUIRED)
GET {{baseUrl}}/conversations/cnv_doesnotexist
X-Device-Id: 00000000-0000-4000-8000-000000000000

### Start a new conversation (build mode) — 201, sections + currentSection: "basic"
# @deviceId must already be registered via the requests above.
POST {{baseUrl}}/conversations
Content-Type: application/json
X-Device-Id: {{deviceId}}

{
  "mode": "build",
  "uploadId": null
}

### POST /devices again — state now reflects the active session (activeSessionId, nextSection: "basic")
POST {{baseUrl}}/devices
Content-Type: application/json
X-Device-Id: {{deviceId}}

{
  "platform": "android",
  "appVersion": "1.0.0",
  "locale": "ar-EG",
  "region": "EG"
}

### GET the session back
# Replace :sessionId with the id returned by "Start a new conversation" above.
GET {{baseUrl}}/conversations/:sessionId
X-Device-Id: {{deviceId}}

### Start another conversation without restart — 409 with activeSessionId
POST {{baseUrl}}/conversations
Content-Type: application/json
X-Device-Id: {{deviceId}}

{
  "mode": "build"
}

### Start another conversation WITH restart:true — deletes the old session (and its cv, if any), creates a new one
POST {{baseUrl}}/conversations
Content-Type: application/json
X-Device-Id: {{deviceId}}

{
  "mode": "build",
  "restart": true
}

### mode: "upload" — not implemented yet (no upload module), INVALID_REQUEST
POST {{baseUrl}}/conversations
Content-Type: application/json
X-Device-Id: {{deviceId}}

{
  "mode": "upload",
  "uploadId": "upl_someid"
}

### Delete the session (and its cv) — 204
# Replace :sessionId with a real session id first.
DELETE {{baseUrl}}/conversations/:sessionId
X-Device-Id: {{deviceId}}

### GET a session belonging to a different device — NOT_FOUND (ownership check, doesn't leak existence)
# X-Device-Id below must belong to a registered device other than the session's owner.
GET {{baseUrl}}/conversations/:sessionId
X-Device-Id: 00000000-0000-4000-8000-000000000001

### Send a message — SSE. This editor's REST Client can't render a stream well; use curl (see README-style note below).
# Replace :sessionId with a real, in_progress session id.
# Short text (<=15 chars) -> no section_card. Longer text -> sectionDone + section_card.
# curl -sN -X POST {{baseUrl}}/conversations/:sessionId/messages \
#   -H "Content-Type: application/json" -H "X-Device-Id: {{deviceId}}" \
#   -d '{"text":"some longer answer here to trigger sectionDone","source":"text"}'
POST {{baseUrl}}/conversations/:sessionId/messages
Content-Type: application/json
X-Device-Id: {{deviceId}}

{
  "text": "some longer answer here to trigger sectionDone",
  "source": "text"
}

### Send a message to a session that isn't in_progress (e.g. already deleted) — INVALID_REQUEST
POST {{baseUrl}}/conversations/:sessionId/messages
Content-Type: application/json
X-Device-Id: {{deviceId}}

{
  "text": "hello",
  "source": "text"
}

### Confirm a section — needs a real messageId from a section_card event above, and :sessionId's currentSection must equal :sectionId.
# Response: { section, status: "confirmed", nextSection, sessionStatus, cvId } — cvId is null unless isLast: true.
POST {{baseUrl}}/conversations/:sessionId/sections/basic/confirm
Content-Type: application/json
X-Device-Id: {{deviceId}}

{
  "messageId": "msg_replace_with_a_real_section_card_id",
  "isLast": false,
  "edits": null
}

### Confirm with edits — replaces the card content with the given shape (validated against that section's schema, same as the AI's own output).
POST {{baseUrl}}/conversations/:sessionId/sections/basic/confirm
Content-Type: application/json
X-Device-Id: {{deviceId}}

{
  "messageId": "msg_replace_with_a_real_section_card_id",
  "isLast": false,
  "edits": { "name": "Mohamed Ali", "title": "Software Engineer", "phone": null, "email": null, "location": "Cairo" }
}

### Confirm a section that isn't the current one — INVALID_REQUEST
POST {{baseUrl}}/conversations/:sessionId/sections/skills/confirm
Content-Type: application/json
X-Device-Id: {{deviceId}}

{
  "messageId": "msg_replace_with_a_real_section_card_id",
  "isLast": false,
  "edits": null
}

### Confirm with a messageId that has no card — INVALID_REQUEST
POST {{baseUrl}}/conversations/:sessionId/sections/basic/confirm
Content-Type: application/json
X-Device-Id: {{deviceId}}

{
  "messageId": "msg_replace_with_a_plain_text_message_id",
  "isLast": false,
  "edits": null
}

### Confirm the last section — closes the CV: nextSection null, sessionStatus "completed", cvId returned
POST {{baseUrl}}/conversations/:sessionId/sections/languages/confirm
Content-Type: application/json
X-Device-Id: {{deviceId}}

{
  "messageId": "msg_replace_with_a_real_section_card_id",
  "isLast": true,
  "edits": null
}
