# API service only. Paste into Railway Variables > Raw Editor.
# Replace the redirect placeholder with YOUR inbox before deploying.
# Postgres service must be named Postgres; references are Railway syntax.
NODE_ENV=production
DEMO_MODE=true
EMAIL_REDIRECT_TO=replace-with-your-own-inbox@example.com
UPLOAD_DIR=/data/uploads
EMAIL_OUTBOX_DIR=/data/outbox
DATABASE_HOST=${{Postgres.RAILWAY_PRIVATE_DOMAIN}}
DATABASE_PORT=5432
DATABASE_USER=${{Postgres.POSTGRES_USER}}
DATABASE_PASSWORD=${{Postgres.POSTGRES_PASSWORD}}
DATABASE_NAME=${{Postgres.POSTGRES_DB}}
DATABASE_SSL=false
LLM_PROVIDER=fake
STT_PROVIDER=fake
EMBEDDING_PROVIDER=fake
AI_MODEL=mistral-small-latest
AI_EXTRACTION_MODEL=mistral-medium-latest
STT_MODEL=voxtral-mini-latest
EMBEDDING_MODEL=mistral-embed
EMAIL_PROVIDER=fake
EMAIL_FROM_NAME=Sanad
JOB_PROVIDER=fake
JOOBLE_MAX_CALLS=450
JOB_CACHE_TTL_DAYS=30
# Let Railway supply PORT. Optional credentials are deliberately omitted.
# For real AI: set AI_API_KEY and the three AI provider values to mistral.
# For email delivery to your inbox: set EMAIL_PROVIDER=resend, RESEND_API_KEY,
# EMAIL_FROM_ADDRESS; KEEP DEMO_MODE=true and EMAIL_REDIRECT_TO set.
